# Copy ONLY to your private backend and replace placeholder secrets.
# Never commit a real .env or store secret values in the mobile client.
MONGODB_URI=mongodb://127.0.0.1:27017/bsquare_mobile
JWT_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081

# LinkedIn Developer Portal > Products:
# "Sign In with LinkedIn using OpenID Connect".
# Authorize this exact redirect URL in your LinkedIn application.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.bsquare.club/api/v1/auth/linkedin/callback-v2

# For desktop browser sign-in testing. On a published web app use the
# actual public HTTPS application callback URL instead.
LINKEDIN_WEB_REDIRECT_URI=http://localhost:8081/linkedin-callback
LINKEDIN_APP_REDIRECT_SCHEME=bsquare

# Must be an existing, approved administrator's exact email.
BSQUARE_ADMIN_EMAILS=

# Resend credentials remain only on the backend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=BSquare <no-reply@your-verified-domain.example>
